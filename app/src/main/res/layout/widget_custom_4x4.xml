<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:weightSum="100">

        <!-- Row 1 (26%): slot_0 (54%) + slot_1 (46%) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="26"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/custom_slot_0_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="54">

                <ImageView
                    android:id="@+id/custom_slot_0_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextClock
                    android:id="@+id/custom_slot_0_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <include
                    android:id="@+id/custom_slot_0_calendar"
                    layout="@layout/widget_custom_calendar_host" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/custom_slot_1_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="46">

                <ImageView
                    android:id="@+id/custom_slot_1_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextClock
                    android:id="@+id/custom_slot_1_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <include
                    android:id="@+id/custom_slot_1_calendar"
                    layout="@layout/widget_custom_calendar_host" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 2 (22%): Full-Width Banner (slot_2) -->
        <FrameLayout
            android:id="@+id/custom_slot_2_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="22">

            <ImageView
                android:id="@+id/custom_slot_2_bitmap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextClock
                android:id="@+id/custom_slot_2_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <include
                android:id="@+id/custom_slot_2_calendar"
                layout="@layout/widget_custom_calendar_host" />
        </FrameLayout>

        <!-- Row 3 (28%): 3 Equal System Cards (slot_3, slot_4, slot_5) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="28"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <FrameLayout
                android:id="@+id/custom_slot_3_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/custom_slot_3_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextClock
                    android:id="@+id/custom_slot_3_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <include
                    android:id="@+id/custom_slot_3_calendar"
                    layout="@layout/widget_custom_calendar_host" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/custom_slot_4_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/custom_slot_4_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextClock
                    android:id="@+id/custom_slot_4_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <include
                    android:id="@+id/custom_slot_4_calendar"
                    layout="@layout/widget_custom_calendar_host" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/custom_slot_5_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/custom_slot_5_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextClock
                    android:id="@+id/custom_slot_5_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <include
                    android:id="@+id/custom_slot_5_calendar"
                    layout="@layout/widget_custom_calendar_host" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 4 (24%): Full-Width Footer Bar (slot_6) -->
        <FrameLayout
            android:id="@+id/custom_slot_6_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="24">

            <ImageView
                android:id="@+id/custom_slot_6_bitmap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextClock
                android:id="@+id/custom_slot_6_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <include
                android:id="@+id/custom_slot_6_calendar"
                layout="@layout/widget_custom_calendar_host" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
