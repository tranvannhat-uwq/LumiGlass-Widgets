<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:weightSum="100">

        <!-- Upper 66%: Left Clock+Date | Right Weather+Lunar+Battery (Moved Up) -->
        <LinearLayout
            android:id="@+id/widget_upper_main_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="66"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="100">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="48"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingEnd="6dp">

                <TextClock
                    android:id="@+id/widget_clock_single"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/widget_clock_split_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextClock
                        android:id="@+id/widget_clock_split_hour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="hh"
                        android:format24Hour="HH"
                        android:includeFontPadding="false"
                        android:shadowColor="#80000000"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textColor="#FFFFFF"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextClock
                        android:id="@+id/widget_clock_split_minute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:format12Hour="mm"
                        android:format24Hour="mm"
                        android:includeFontPadding="false"
                        android:shadowColor="#80000000"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textColor="#BAE6FD"
                        android:textSize="36sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_date_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:shadowColor="#70000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="52"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="6dp">

                <LinearLayout
                    android:id="@+id/widget_weather_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_weather_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/widget_weather_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:shadowColor="#80000000"
                                android:shadowDy="1"
                                android:shadowRadius="4"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/widget_weather_condition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:shadowColor="#70000000"
                                android:shadowDy="1"
                                android:shadowRadius="3"
                                android:textColor="#E2E8F0"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/widget_weather_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="#70000000"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textColor="#CBD5E1"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_lunar_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#70000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#BAE6FD"
                    android:textSize="11.8sp" />

                <LinearLayout
                    android:id="@+id/widget_battery_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_battery_gauge"
                        android:layout_width="32dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_battery_percent_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:shadowColor="#70000000"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_battery_temp_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:shadowColor="#70000000"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="#E2E8F0"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- RAM Telemetry Module -->
                <LinearLayout
                    android:id="@+id/widget_ram_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_ram_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_glass_ram" />

                    <TextView
                        android:id="@+id/widget_ram_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:shadowColor="#70000000"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="#E0F2FE"
                        android:textSize="11.2sp" />
                </LinearLayout>

                <!-- Trio Glass Telemetry Cards Cluster (Pin + Bộ nhớ + RAM) -->
                <LinearLayout
                    android:id="@+id/widget_telemetry_trio_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="3">

                    <ImageView
                        android:id="@+id/widget_card_battery"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <ImageView
                        android:id="@+id/widget_card_storage"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <ImageView
                        android:id="@+id/widget_card_ram"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Lower 34%: 5-Day or 7-Day Solar & Lunar Calendar Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="34"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <include layout="@layout/include_week_calendar_strip" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
