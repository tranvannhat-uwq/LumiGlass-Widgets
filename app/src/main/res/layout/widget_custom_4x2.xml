<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:weightSum="100">

        <!-- Upper 62%: Left (45%) + Right (55%) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="62"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="100">

            <!-- Left Column (45%): slot_0 (62%) + slot_1 (38%) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="45"
                android:orientation="vertical"
                android:weightSum="100">

                <FrameLayout
                    android:id="@+id/custom_slot_0_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="3dp"
                    android:layout_weight="62">

                    <ImageView
                        android:id="@+id/custom_slot_0_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextClock
                        android:id="@+id/custom_slot_0_clock"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#80000000"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/custom_slot_1_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="38">

                    <ImageView
                        android:id="@+id/custom_slot_1_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextClock
                        android:id="@+id/custom_slot_1_clock"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#80000000"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Right Column (55%): slot_2 (42%) + slot_3 (58%) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="55"
                android:orientation="vertical"
                android:weightSum="100">

                <FrameLayout
                    android:id="@+id/custom_slot_2_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="3dp"
                    android:layout_weight="42">

                    <ImageView
                        android:id="@+id/custom_slot_2_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextClock
                        android:id="@+id/custom_slot_2_clock"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#80000000"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/custom_slot_3_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="58">

                    <ImageView
                        android:id="@+id/custom_slot_3_bitmap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextClock
                        android:id="@+id/custom_slot_3_clock"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#80000000"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Lower 38%: Full-Width Bottom Bar (slot_4) -->
        <FrameLayout
            android:id="@+id/custom_slot_4_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="38">

            <ImageView
                android:id="@+id/custom_slot_4_bitmap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextClock
                android:id="@+id/custom_slot_4_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
