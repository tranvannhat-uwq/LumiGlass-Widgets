<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:weightSum="100">

        <!-- Zone 1 (34%): Clock & Full Vietnamese Gregorian + Lunar Calendar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="34"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/widget_clock_single"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/widget_clock_split_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextClock
                    android:id="@+id/widget_clock_split_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh"
                    android:format24Hour="HH"
                    android:includeFontPadding="false"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextClock
                    android:id="@+id/widget_clock_split_minute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:includeFontPadding="false"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#BAE6FD"
                    android:textSize="38sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#70000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#F8FAFC"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/widget_lunar_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#70000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#BAE6FD"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Zone 2 (34%): Weather Station + Battery Telemetry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="34"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_weather_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_weather_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:shadowColor="#80000000"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_weather_condition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="#70000000"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textColor="#F1F5F9"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_weather_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#70000000"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="#CBD5E1"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_battery_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_battery_gauge"
                    android:layout_width="36dp"
                    android:layout_height="17dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_battery_percent_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:shadowColor="#70000000"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_battery_temp_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#70000000"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- RAM Telemetry Module (4x4 Dashboard) -->
            <LinearLayout
                android:id="@+id/widget_ram_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_ram_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_glass_ram" />

                <TextView
                    android:id="@+id/widget_ram_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:shadowColor="#70000000"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#E0F2FE"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Zone 3 (32%): 5-Day or 7-Day Solar & Lunar Calendar Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="32"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <include layout="@layout/include_week_calendar_strip" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
