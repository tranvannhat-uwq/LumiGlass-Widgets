<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="10dp">

        <TextClock
            android:id="@+id/widget_clock_single"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_clock_split_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextClock
                android:id="@+id/widget_clock_split_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/widget_clock_split_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#E0F2FE"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#70000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_lunar_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#70000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#BAE6FD"
            android:textSize="10sp" />

        <!-- Hidden views for uniform binder compatibility across tiers -->
        <LinearLayout
            android:id="@+id/widget_weather_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_weather_temp"
                android:layout_width="0dp"
                android:layout_height="0dp" />
            <TextView
                android:id="@+id/widget_weather_condition"
                android:layout_width="0dp"
                android:layout_height="0dp" />
            <TextView
                android:id="@+id/widget_weather_details"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_battery_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_battery_gauge"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_battery_percent_text"
                android:layout_width="0dp"
                android:layout_height="0dp" />
            <TextView
                android:id="@+id/widget_battery_temp_text"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
