<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:weightSum="100">

        <!-- Row 1 (50%): Full-width Top Slot -->
        <FrameLayout
            android:id="@+id/custom_slot_0_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="50">

            <ImageView
                android:id="@+id/custom_slot_0_bitmap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <TextClock
                android:id="@+id/custom_slot_0_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <include
                android:id="@+id/custom_slot_0_calendar"
                layout="@layout/widget_custom_calendar_host" />
        </FrameLayout>

        <!-- Row 2 (50%): 2 Equal Bottom Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="50"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <FrameLayout
                android:id="@+id/custom_slot_1_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/custom_slot_1_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextClock
                    android:id="@+id/custom_slot_1_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <include
                    android:id="@+id/custom_slot_1_calendar"
                    layout="@layout/widget_custom_calendar_host" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/custom_slot_2_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/custom_slot_2_bitmap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <TextClock
                    android:id="@+id/custom_slot_2_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <include
                    android:id="@+id/custom_slot_2_calendar"
                    layout="@layout/widget_custom_calendar_host" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
